<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{

background:#eef3f9;

display:flex;

}

/* Sidebar */

.sidebar{

width:270px;

height:100vh;

background:#0b3d91;

color:#fff;

position:fixed;

left:0;

top:0;

padding:30px 20px;

overflow:auto;

}

.sidebar h2{

text-align:center;

margin-bottom:40px;

}

.sidebar ul{

list-style:none;

}

.sidebar ul li{

margin:18px 0;

}

.sidebar ul li a{

color:white;

text-decoration:none;

display:block;

padding:12px;

border-radius:10px;

transition:.3s;

}

.sidebar ul li a:hover{

background:#1d5ed8;

}

.sidebar ul li i{

margin-right:10px;

}

/* Main */

.main{

margin-left:270px;

width:calc(100% - 270px);

}

/* Navbar */

.navbar{

height:70px;

background:white;

display:flex;

justify-content:space-between;

align-items:center;

padding:0 30px;

box-shadow:0 3px 10px rgba(0,0,0,.08);

}

.search{

padding:10px;

border-radius:8px;

border:1px solid #ccc;

width:280px;

}

.profile{

display:flex;

align-items:center;

gap:15px;

}

.profile img{

width:45px;

height:45px;

border-radius:50%;

}

.content{

padding:30px;

}

/* Welcome */

.welcome{

background:linear-gradient(135deg,#0b3d91,#2196f3);

color:white;

padding:30px;

border-radius:15px;

margin-bottom:30px;

}

.welcome h1{

font-size:30px;

margin-bottom:10px;

}

/* Cards */

.cards{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(220px,1fr));

gap:20px;

margin-bottom:30px;

}

.card{

background:white;

padding:25px;

border-radius:15px;

box-shadow:0 5px 15px rgba(0,0,0,.08);

transition:.3s;

}

.card:hover{

transform:translateY(-6px);

}

.card i{

font-size:35px;

color:#0b3d91;

margin-bottom:15px;

}

.card h2{

color:#0b3d91;

margin-bottom:8px;

}

.card span{

font-size:28px;

font-weight:700;

}

/* Responsive */

@media(max-width:900px){

.sidebar{

width:90px;

}

.sidebar h2{

display:none;

}

.sidebar a span{

display:none;

}

.main{

margin-left:90px;

width:calc(100% - 90px);

}

}

</style>

